<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".MainActivity">

    <!-- Wraps PreviewView so we can change its aspect ratio at runtime (dimensionRatio is set
         programmatically in MainActivity when the user picks 1:1 / 4:5 / 16:9). -->
    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="9:16"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Live recording timer, e.g. "0:07" -->
    <TextView
        android:id="@+id/timerText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="0:00"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:fontFeatureSettings="tnum"
        android:background="#33FF3B30"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Open a video from the gallery and edit it -->
    <TextView
        android:id="@+id/editVideoButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="16dp"
        android:text="✏️ Edit"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:background="#66000000"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Aspect ratio button, top-right -->
    <TextView
        android:id="@+id/ratioButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="16dp"
        android:text="16:9"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:background="#66000000"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Ratio picker chips, hidden until ratioButton is tapped -->
    <LinearLayout
        android:id="@+id/ratioPicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#99000000"
        android:padding="6dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/ratioButton"
        app:layout_constraintEnd_toEndOf="@id/ratioButton"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/ratioChip_1_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1:1"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp" />

        <TextView
            android:id="@+id/ratioChip_4_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4:5"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp" />

        <TextView
            android:id="@+id/ratioChip_16_9"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="16:9"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp" />

    </LinearLayout>

    <!-- Selected filter name, shown under the filter strip like Instagram -->
    <TextView
        android:id="@+id/filterNameLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Normal"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:shadowColor="#000000"
        android:shadowRadius="4"
        app:layout_constraintBottom_toTopOf="@id/filterStrip"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="8dp" />

    <!-- Instagram-style horizontal filter strip -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/filterStrip"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:clipToPadding="false"
        android:paddingHorizontal="140dp"
        app:layout_constraintBottom_toTopOf="@id/captureButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="18dp"
        tools:listitem="@layout/item_filter" />

    <com.app.videoeditor.widget.CameraCaptureButton
        android:id="@+id/captureButton"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"

        app:ccb_ringColorIdle="#FFFFFF"
        app:ccb_ringColorRecording="#FF3B30"
        app:ccb_innerColorIdle="#FFFFFF"
        app:ccb_innerColorRecording="#FF3B30"
        app:ccb_ringStrokeWidthRatio="0.09"
        app:ccb_innerRadiusRatioIdle="0.80"
        app:ccb_innerRadiusRatioRecording="0.55"
        app:ccb_ringGrowthRatio="0.06"
        app:ccb_pressScale="0.88"
        app:ccb_idleRingAlpha="200"
        app:ccb_recordingTrackAlpha="60"
        app:ccb_maxHoldMs="15000"
        app:ccb_longPressThresholdMs="200"
        app:ccb_zoomEnabled="true"
        app:ccb_zoomDragRange="220dp"
        app:ccb_minZoomFactor="1.0"
        app:ccb_maxZoomFactor="4.0"
        app:ccb_photoEnabled="true"
        app:ccb_videoEnabled="true"
        app:ccb_hapticsEnabled="true"
        app:ccb_pressAnimEnabled="true"
        app:ccb_recordPulseEnabled="true" />

    <!-- Vertical zoom rail: only visible while recording -->
    <LinearLayout
        android:id="@+id/zoomRail"
        android:layout_width="36dp"
        android:layout_height="160dp"
        android:orientation="vertical"
        android:gravity="bottom|center_horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/captureButton"
        app:layout_constraintEnd_toEndOf="@id/captureButton"
        app:layout_constraintStart_toStartOf="@id/captureButton"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/zoomLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.0x"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="#33FFFFFF"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:layout_marginBottom="8dp" />

        <FrameLayout
            android:layout_width="4dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#4DFFFFFF">

            <View
                android:id="@+id/zoomFill"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_gravity="bottom"
                android:background="#FF3B30" />
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
